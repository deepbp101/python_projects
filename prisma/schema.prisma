// Wedding planner — Phase 1 data model.
//
// Money is stored everywhere as integer cents to keep arithmetic exact;
// see src/lib/money.ts for the formatting/parsing helpers.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  collaborations Collaborator[]  @relation("CollaboratorUser")
  invitesSent    Collaborator[]  @relation("CollaboratorInvitedBy")
  tasksCompleted Task[]          @relation("TaskCompletedBy")
  uploads        Upload[]        @relation("UploadCreatedBy")
  moodItems      MoodBoardItem[] @relation("MoodItemCreatedBy")

  @@map("users")
}

/// Server-side sessions. Only the SHA-256 hash of the cookie token is stored,
/// so a database leak does not hand out live sessions.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Workspace
// ---------------------------------------------------------------------------

enum CollaboratorRole {
  OWNER
  PARTNER
  PLANNER
  FAMILY
}

enum CollaboratorStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum WorkspaceSection {
  TASKS
  BUDGET
  GUESTS
  VENDORS
  SEATING
  MOODBOARD
  WEBSITE
}

enum AccessLevel {
  NONE
  VIEW
  EDIT
}

model Wedding {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  weddingDate   DateTime
  venueName     String?
  location      String?
  timezone      String   @default("UTC")
  currency      String   @default("USD")
  totalBudget   Int      @default(0)
  coverImageUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collaborators    Collaborator[]
  tasks            Task[]
  budgetCategories BudgetCategory[]
  budgetItems      BudgetItem[]
  households       Household[]
  guests           Guest[]
  guestTags        GuestTag[]
  mealOptions      MealOption[]
  uploads          Upload[]
  site             WeddingSite?
  seatingTables    SeatingTable[]
  moodBoard        MoodBoard?

  @@map("weddings")
}

/// Membership of a wedding workspace. A row exists from the moment an invite is
/// sent; `userId` stays null until the invitee accepts and has an account.
model Collaborator {
  id              String             @id @default(cuid())
  weddingId       String
  userId          String?
  email           String
  name            String?
  role            CollaboratorRole   @default(FAMILY)
  status          CollaboratorStatus @default(INVITED)
  inviteTokenHash String?            @unique
  inviteExpiresAt DateTime?
  invitedById     String?
  joinedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  wedding       Wedding                  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user          User?                    @relation("CollaboratorUser", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy     User?                    @relation("CollaboratorInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  permissions   CollaboratorPermission[]
  assignedTasks Task[]                   @relation("TaskAssignedTo")

  @@unique([weddingId, email])
  @@index([weddingId])
  @@index([userId])
  @@map("collaborators")
}

/// Per-section access. Rows are only consulted for non-owner roles; OWNER and
/// PARTNER always resolve to EDIT (see src/lib/permissions.ts).
model CollaboratorPermission {
  id             String           @id @default(cuid())
  collaboratorId String
  section        WorkspaceSection
  access         AccessLevel      @default(VIEW)

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@unique([collaboratorId, section])
  @@map("collaborator_permissions")
}

// ---------------------------------------------------------------------------
// Checklist
// ---------------------------------------------------------------------------

enum Milestone {
  TWELVE_MONTHS
  NINE_MONTHS
  SIX_MONTHS
  THREE_MONTHS
  ONE_MONTH
  ONE_WEEK
  DAY_OF
  AFTER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id            String       @id @default(cuid())
  weddingId     String
  title         String
  description   String?
  category      String       @default("General")
  milestone     Milestone
  dueDate       DateTime?
  priority      TaskPriority @default(MEDIUM)
  /// False for tasks generated from the default timeline catalog.
  isCustom      Boolean      @default(false)
  /// Stable key of the catalog entry this task came from, so regenerating the
  /// timeline does not duplicate tasks the couple already has.
  templateKey   String?
  sortOrder     Int          @default(0)
  completedAt   DateTime?
  completedById String?
  assignedToId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  wedding     Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  completedBy User?         @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  assignedTo  Collaborator? @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@unique([weddingId, templateKey])
  @@index([weddingId, milestone])
  @@index([weddingId, dueDate])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Budget
// ---------------------------------------------------------------------------

model BudgetCategory {
  id                String   @id @default(cuid())
  weddingId         String
  name              String
  plannedAmount     Int      @default(0)
  /// Percentage of `plannedAmount` at which the UI warns the couple.
  alertThresholdPct Int      @default(90)
  color             String   @default("#B08968")
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  wedding Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  items   BudgetItem[]

  @@unique([weddingId, name])
  @@index([weddingId])
  @@map("budget_categories")
}

model BudgetItem {
  id            String   @id @default(cuid())
  weddingId     String
  categoryId    String
  name          String
  vendorName    String?
  plannedAmount Int      @default(0)
  /// Set manually for one-off costs; when the item has payments, the payment
  /// total is what the rollups use instead (see src/lib/domain/budget.ts).
  actualAmount  Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wedding  Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([weddingId])
  @@index([categoryId])
  @@map("budget_items")
}

/// Deposits and installments. Weddings are rarely paid in one go, so due-date
/// reminders hang off individual payments rather than the line item.
model Payment {
  id           String    @id @default(cuid())
  budgetItemId String
  label        String    @default("Payment")
  amount       Int
  dueDate      DateTime?
  paidAt       DateTime?
  method       String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  budgetItem BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)

  @@index([budgetItemId])
  @@index([dueDate])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Guests & RSVP
// ---------------------------------------------------------------------------

enum AgeGroup {
  ADULT
  CHILD
  INFANT
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
  MAYBE
}

/// Invitations are addressed to a household, not to an individual, so the
/// mailing address lives here and guests inherit it.
model Household {
  id           String   @id @default(cuid())
  weddingId    String
  name         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guests  Guest[]

  @@index([weddingId])
  @@map("households")
}

model Guest {
  id                  String   @id @default(cuid())
  weddingId           String
  householdId         String?
  firstName           String
  lastName            String
  email               String?
  phone               String?
  ageGroup            AgeGroup @default(ADULT)
  dietaryRestrictions String?
  notes               String?
  plusOneAllowed      Boolean  @default(false)
  /// A plus-one is a full guest row pointing back at its host, so it can carry
  /// its own meal choice and dietary needs.
  plusOneOfGuestId    String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  wedding   Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  household Household?        @relation(fields: [householdId], references: [id], onDelete: SetNull)
  plusOneOf Guest?            @relation("GuestPlusOne", fields: [plusOneOfGuestId], references: [id], onDelete: Cascade)
  plusOne   Guest?            @relation("GuestPlusOne")
  rsvp      Rsvp?
  tags      GuestTagOnGuest[]
  seat      SeatAssignment?

  @@index([weddingId])
  @@index([householdId])
  @@map("guests")
}

model GuestTag {
  id        String   @id @default(cuid())
  weddingId String
  name      String
  color     String   @default("#7D8471")
  createdAt DateTime @default(now())

  wedding Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guests  GuestTagOnGuest[]

  @@unique([weddingId, name])
  @@index([weddingId])
  @@map("guest_tags")
}

model GuestTagOnGuest {
  guestId String
  tagId   String

  guest Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tag   GuestTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([guestId, tagId])
  @@index([tagId])
  @@map("guest_tags_on_guests")
}

model MealOption {
  id          String   @id @default(cuid())
  weddingId   String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  rsvps   Rsvp[]

  @@unique([weddingId, name])
  @@index([weddingId])
  @@map("meal_options")
}

model Rsvp {
  id           String     @id @default(cuid())
  guestId      String     @unique
  status       RsvpStatus @default(PENDING)
  mealOptionId String?
  respondedAt  DateTime?
  message      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  guest      Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  mealOption MealOption? @relation(fields: [mealOptionId], references: [id], onDelete: SetNull)

  @@index([mealOptionId])
  @@map("rsvps")
}

// ---------------------------------------------------------------------------
// Uploads (Phase 2)
// ---------------------------------------------------------------------------

/// A stored file. The bytes live behind a storage driver (local disk in
/// development, S3-compatible in production — see src/lib/storage), and this
/// row is the only thing the rest of the app references.
model Upload {
  id           String   @id @default(cuid())
  weddingId    String
  /// Opaque key the storage driver resolves; never a user-supplied path.
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  createdById  String?
  createdAt    DateTime @default(now())

  wedding       Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  createdBy     User?           @relation("UploadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  moodBoardItem MoodBoardItem?
  siteCoverFor  WeddingSite?

  @@index([weddingId])
  @@map("uploads")
}

// ---------------------------------------------------------------------------
// Wedding website (Phase 2)
// ---------------------------------------------------------------------------

enum SiteTemplate {
  CLASSIC
  GARDEN
  MODERN
}

/// The couple's public-facing site. Exists whether or not it is published;
/// `publishedAt` is what makes it reachable at /wedding/[slug].
model WeddingSite {
  id           String       @id @default(cuid())
  weddingId    String       @unique
  /// Public URL segment, separate from the workspace slug so the couple can
  /// choose something shareable without changing internal links.
  slug         String       @unique
  template     SiteTemplate @default(CLASSIC)
  headline     String?
  intro        String?
  storyTitle   String       @default("Our story")
  story        String?
  travelTitle  String       @default("Travel & stays")
  travel       String?
  registryNote String?
  /// Shown to guests so they know when to reply by.
  rsvpDeadline DateTime?
  rsvpNote     String?
  publishedAt  DateTime?
  coverUploadId String?     @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  wedding    Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  coverImage Upload?        @relation(fields: [coverUploadId], references: [id], onDelete: SetNull)
  events     SiteEvent[]
  registry   RegistryLink[]

  @@map("wedding_sites")
}

/// Ceremony, reception, welcome drinks, farewell brunch — anything with a time
/// and a place that guests need to know about.
model SiteEvent {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  startsAt    DateTime
  endsAt      DateTime?
  venueName   String?
  address     String?
  description String?
  dressCode   String?
  mapUrl      String?
  sortOrder   Int      @default(0)

  site WeddingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_events")
}

model RegistryLink {
  id        String   @id @default(cuid())
  siteId    String
  label     String
  url       String
  note      String?
  sortOrder Int      @default(0)

  site WeddingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("registry_links")
}

// ---------------------------------------------------------------------------
// Seating chart (Phase 2)
// ---------------------------------------------------------------------------

enum TableShape {
  ROUND
  RECTANGLE
  HEAD
}

/// A table on the floor plan. `x` and `y` are percentages of the canvas
/// (0-100) rather than pixels, so a chart laid out on a laptop still reads
/// correctly on a phone.
model SeatingTable {
  id        String     @id @default(cuid())
  weddingId String
  name      String
  shape     TableShape @default(ROUND)
  capacity  Int        @default(8)
  x         Float      @default(50)
  y         Float      @default(50)
  rotation  Int        @default(0)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  wedding     Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  assignments SeatAssignment[]

  @@unique([weddingId, name])
  @@index([weddingId])
  @@map("seating_tables")
}

/// One guest at one table. `guestId` is unique, so a guest cannot be seated in
/// two places at once — the database enforces it rather than the UI.
model SeatAssignment {
  id        String   @id @default(cuid())
  tableId   String
  guestId   String   @unique
  seatIndex Int?
  createdAt DateTime @default(now())

  table SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guest Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@map("seat_assignments")
}

// ---------------------------------------------------------------------------
// Mood board (Phase 2)
// ---------------------------------------------------------------------------

enum MoodCategory {
  ATTIRE
  FLORALS
  DECOR
  VENUE
  CAKE
  STATIONERY
  BEAUTY
  OTHER
}

/// Created lazily the first time the couple opens the mood board. Sharing is a
/// property of the board, so revoking a link kills access to every image at once.
model MoodBoard {
  id             String    @id @default(cuid())
  weddingId      String    @unique
  title          String    @default("Our vision")
  /// Only the hash of the share token is stored, same as sessions and invites.
  shareTokenHash String?   @unique
  sharedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  wedding Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  items   MoodBoardItem[]

  @@map("mood_boards")
}

model MoodBoardItem {
  id          String       @id @default(cuid())
  boardId     String
  uploadId    String?      @unique
  category    MoodCategory @default(OTHER)
  title       String?
  note        String?
  /// Where the couple found it, so credit survives the download.
  sourceUrl   String?
  sortOrder   Int          @default(0)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  board     MoodBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  upload    Upload?   @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("MoodItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([boardId, category])
  @@map("mood_board_items")
}
