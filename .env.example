# Local development environment.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wedding_planner?schema=public"

# Any long random string; used to hash session and invite tokens.
# Generate with: openssl rand -hex 32
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# Public origin, used to build invite links, QR codes and itinerary links.
# In production this MUST be the real https:// address — the QR codes printed
# for the tables are built from it, and a wrong value prints unusable codes.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# "local" writes to UPLOAD_DIR on disk. Correct for development and for a
# single server you own; it loses every guest photo on the next deploy anywhere
# with an ephemeral filesystem, which is most hosts.
STORAGE_DRIVER="local"
UPLOAD_DIR=".uploads"

# "s3" targets any S3-compatible bucket — Cloudflare R2, AWS S3, MinIO, B2.
# The bucket must stay PRIVATE: files are fetched by the server and passed
# through an access-checked route, which is what lets a hidden photo actually
# become unreachable. A public bucket hands out URLs no moderation can withdraw.
#
# STORAGE_DRIVER="s3"
# S3_BUCKET="wedding-uploads"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
#
# Cloudflare R2 — the endpoint is per-account, from the R2 dashboard:
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
#
# AWS S3 — no endpoint, and a real region:
# S3_REGION="us-east-1"
#
# MinIO and some proxies serve buckets as a path segment, not a subdomain:
# S3_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Switches on the writing assistant (vows, speeches, thank-you notes,
# invitation wording), which runs on claude-haiku-4-5. Leave it unset and the
# assistant reports itself off; the style matchmaker still works without it,
# since its matching is scored locally and only the summary needs a model.
# ANTHROPIC_API_KEY="sk-ant-..."
