# Local development environment.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wedding_planner?schema=public"

# Any long random string; used to hash session and invite tokens.
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# Public origin, used to build invite links.
APP_URL="http://localhost:3000"

# File storage. "local" writes to UPLOAD_DIR on disk.
STORAGE_DRIVER="local"
UPLOAD_DIR=".uploads"

# Optional. Switches on the writing assistant (vows, speeches, thank-you notes,
# invitation wording), which runs on claude-haiku-4-5. Leave it unset and the
# assistant reports itself off; the style matchmaker still works without it,
# since its matching is scored locally and only the summary needs a model.
# ANTHROPIC_API_KEY="sk-ant-..."
